# Server Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/parkingpal?schema=public"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-key-here-min-32-characters-long
JWT_REFRESH_SECRET=your-different-refresh-secret-here-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=ParkingPal <noreply@parkingpal.fr>

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Logging (Options: error, warn, info, http, debug)
LOG_LEVEL=info

# Stripe Payment (Optional - will mock if not provided)
STRIPE_SECRET_KEY=pk_test_51T1XLXPW8wDq2NseTbInkv2pl8gN3mBhVIuqBl7P99DBRCTPVkoBUxx5ksgNNBgHQV5tGqwPCChXQ32TZ1tcrvDV00vEWyIHwD   
STRIPE_WEBHOOK_SECRET=whsec_f7ef1dca5e144fa413e17357df47422abc603426dd2448581b3eb1f2e9a35978

# Twilio SMS (Optional - will mock if not provided)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# OAuth - Google Sign-In (Optional - will be disabled if not provided)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For iOS (different client ID)
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# OAuth - Apple Sign-In (Optional - will be disabled if not provided)
# Get from: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=com.parkingpal.app.signin
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
