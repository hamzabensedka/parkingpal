# Server Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/parkingpal?schema=public"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-key-here-min-32-characters-long
JWT_REFRESH_SECRET=your-different-refresh-secret-here-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=ParkingPal <noreply@parkingpal.fr>

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
